{
  "name": "webpush-native-mcp",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "dev:client": "vite --config client/vite.config.ts",
    "build:client": "vite build --config client/vite.config.ts",
    "deploy": "npm run build:client && wrangler deploy",
    "deploy:prod": "npm run build:client && wrangler deploy --env production",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.12.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.2",
    "@cloudflare/workers-types": "^4.20260501.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "capnp-ts": "^0.7.0",
    "miniflare": "^4.20260430.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wrangler": "^4.87.0"
  }
}
