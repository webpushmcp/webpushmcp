{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webpush-native-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PUSH_STORE",
        "class_name": "PushSubscriptionStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "PushSubscriptionStore"
      ]
    }
  ],
  "vars": {
    "VAPID_SUBJECT": "mailto:admin@webpush-native-mcp.workers.dev",
    "BASE_URL": "http://localhost:8787"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "webpushmcp.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "VAPID_SUBJECT": "mailto:admin@webpushmcp.com",
        "BASE_URL": "https://webpushmcp.com"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "PUSH_STORE",
            "class_name": "PushSubscriptionStore"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    }
  }
}
